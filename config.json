            "title": "出口流量排行",
            "description": "最近 24 小时；可搜索 Sing-box 出站标签。",
            "id_field": "id",
            "api": { "list": "/plugin/xboard-statistic/ranking/outbound" },
            "columns": [
                { "key": "rank", "title": "排名", "type": "number", "width": 70 },
                { "key": "label", "title": "出口", "type": "string", "searchable": true },
                { "key": "total_bytes", "title": "总字节", "type": "string", "sortable": true },
