        "source-ip": {
            "version": 1,
            "title": "来源 IP 排行",
            "description": "最近 24 小时；支持精确搜索 IPv4/IPv6、unknown 或 __other__。",
            "id_field": "id",
            "api": { "list": "/plugin/xboard-statistic/ranking/source_ip" },
            "columns": [
                { "key": "rank", "title": "排名", "type": "number", "width": 70 },
                { "key": "label", "title": "来源 IP", "type": "string", "searchable": true },
                { "key": "total_bytes", "title": "总字节", "type": "string", "sortable": true },
                { "key": "upload_bytes", "title": "上传字节", "type": "string", "sortable": true },
                { "key": "download_bytes", "title": "下载字节", "type": "string", "sortable": true },
                { "key": "percentage", "title": "占比 %", "type": "number" }
            ],
            "form": {},
            "actions": { "create": false, "edit": false, "delete": false }
        },
        "destination-ip": {
            "version": 1,
            "title": "目的 IP 排行",
            "description": "最近 24 小时；支持精确搜索 IPv4/IPv6、unknown 或 __other__。",
            "id_field": "id",
            "api": { "list": "/plugin/xboard-statistic/ranking/destination_ip" },
