{
    "name": "karllee830/xboard-statistic",
    "description": "Xboard multidimensional traffic statistics plugin",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "maxmind-db/reader": "^1.13"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "psr-4": {
            "Plugin\\XboardStatistic\\": ""
        },
        "exclude-from-classmap": [
            "/tests/"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Plugin\\XboardStatistic\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": false,
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
